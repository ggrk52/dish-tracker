[Unit]
Description=Dish Tracker - Семейный график мытья посуды
After=network.target

[Service]
Type=simple
# Если имя пользователя на Raspberry Pi отличается от pi, измените User и WorkingDirectory
User=pi
WorkingDirectory=/home/pi/dish-tracker
ExecStart=/usr/bin/env node server.js
Restart=always
RestartSec=3
Environment=PORT=8080

[Install]
WantedBy=multi-user.target
